# dubai (SM7325/yupik) on top of gki_defconfig and vendor/tundra.config.
# tundra.config carries the shared lahaina/yupik platform; this adds the
# yupik SoC drivers and the dubai peripherals. Everything is built in.

# SoC
CONFIG_SM_GCC_YUPIK=y
CONFIG_SM_GPUCC_YUPIK=y
CONFIG_SM_VIDEOCC_YUPIK=y
CONFIG_SM_DISPCC_YUPIK=y
CONFIG_SM_CAMCC_YUPIK=y
CONFIG_PINCTRL_YUPIK=y
CONFIG_INTERCONNECT_QCOM_YUPIK=y
CONFIG_PHY_QCOM_UFS_V4_YUPIK=y
CONFIG_QTI_CAMERA_YUPIK=y

# Haptics (awinic,haptic_nv) and NFC (st,st21nfc)
CONFIG_INPUT_AWINIC_HAPTIC=y
CONFIG_AW862X_HAPTIC=y
CONFIG_NFC_ST21NFC=y

# The goodix Kbuild has no dubai table; override tundra's so dubai builds
# without a product define, as it did on 5.4.
CONFIG_GTP_PRODUCT="dubai"

# WCN6750 on WPSS through icnss2, in place of tundra's QCA6490 on PCIe
# CONFIG_CNSS2 is not set
# CONFIG_CNSS_QCA6490 is not set
CONFIG_ICNSS2=y
CONFIG_ICNSS2_QMI=y
CONFIG_CNSS_QCA6750=y

# USB is high-speed only: the dubai overlay disables the QMP SS PHY and
# gives dwc3 usb_nop_phy (usb-nop-xceiv) as its second PHY.
CONFIG_NOP_USB_XCEIV=y

# The display SKU library reads the feat_conf fuses from soc:qfprom@0 in
# sysfs; without them the composer can't create the primary display.
CONFIG_QCOM_QFPROM_SYS=y

# The aw882xx PAs are on SENARY MI2S and there are no PMIC SoundWire
# haptics. tundra's settings put the PAs on PRIMARY MI2S and add an
# "swr-haptics" codec to RX_CDC_DMA_RX_6 that never registers here, so the
# sound card defers forever.
# CONFIG_SND_PRI_MI2S_AW882XX is not set
# CONFIG_SND_ENABLE_QCOM_PMIC_HAPTIC is not set

# tundra-specific camera CSIPHY CTLE and voltage overrides not used on dubai
# CONFIG_CAM_CTLE_ENABLE is not set
# CONFIG_CAMERA_VOLTAGE_COMPATIBLE is not set

# Match 5.4 lineage_dubai.config (unset -> 0) so critical thermal trips use
# orderly_poweroff() without a 100ms forced emergency poweroff timer.
CONFIG_THERMAL_EMERGENCY_POWEROFF_DELAY_MS=0

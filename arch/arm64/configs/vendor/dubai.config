# dubai (SM7325/yupik) on top of gki_defconfig and vendor/tundra.config.
# tundra.config carries the shared lahaina/yupik platform; this adds the
# yupik SoC drivers and the dubai peripherals. Everything is built in.

# SoC
CONFIG_SM_GCC_YUPIK=y
CONFIG_SM_GPUCC_YUPIK=y
CONFIG_SM_VIDEOCC_YUPIK=y
CONFIG_SM_DISPCC_YUPIK=y
CONFIG_SM_CAMCC_YUPIK=y
CONFIG_PINCTRL_YUPIK=y
CONFIG_INTERCONNECT_QCOM_YUPIK=y
CONFIG_PHY_QCOM_UFS_V4_YUPIK=y

# Haptics (awinic,haptic_nv) and NFC (st,st21nfc)
CONFIG_INPUT_AWINIC_HAPTIC=y
CONFIG_AW862X_HAPTIC=y
CONFIG_NFC_ST21NFC=y

# The goodix Kbuild has no dubai table; override tundra's so dubai builds
# without a product define, as it did on 5.4.
CONFIG_GTP_PRODUCT="dubai"
